model "simple_avg_rectifier" {
    configuration {
        hil_device = "VHIL+"
        hil_configuration_id = 1
        simulation_method = exact
        simulation_time_step = auto
        simulation_discret_scaling = 1.0
        dsp_timer_periods = 100e-6, 50e-3
        ss_calc_method = "systematic elimination"
        enb_pole_shift = True
        enb_gds_oversampling = True
        show_modes = False
        device_ao_limit_enable = False
        reset_analog_outputs_on_sim_stop = True
        reset_analog_outputs_on_sim_stop_mode = Offset values
        reset_digital_outputs_on_sim_stop = True
        vhil_adio_loopback = False
        dma_enable = False
        cpl_stb = False
        enb_dep_sw_detect = False
        code_section = "internal memory"
        data_section = "internal memory"
        sys_sp_rate_1 = 0.0001
        sys_sp_rate_2 = 0.05
        sys_real_type_precision = "default"
        user_real_type_precision = "default"
        sys_cpu_optimization = "high"
        user_cpu_optimization = "high"
        user_cpu_part_option = "default"
        matrix_based_reduction = True
        cpl_dynamics_analysis = False
        export_ss_to_pickle = False
        ground_scope_core = False
        dss_num_tol = 1e-15
        cce_platform = "generic"
        cce_use_relative_names = False
        cce_type_mapping_real = "double"
        cce_type_mapping_uint = "unsigned int"
        cce_type_mapping_int = "int"
        cce_platform = "generic"
        cce_use_relative_names = False
        cce_type_mapping_real = "double"
        cce_type_mapping_uint = "unsigned int"
        cce_type_mapping_int = "int"
        cce_term_var_location = "local"
        cce_directory = ""
        cce_custom_type_int = ""
        cce_custom_type_uint = ""
        cce_custom_type_real = ""
        tunable_params = "component defined"
        sp_compiler_type = "C compiler"
        sig_stim = "off"
        export_resource_list = ""
        export_dependency_list = ""
        excluded_resource_list = ""
        excluded_component_from_locking_list = ""
        export_out_file = ""
        export_lock_top_level = True
        export_encrypt_library = True
        export_encrypt_resources = True
        solver_type = "DAE"
        integration_method = "BDF"
        max_sim_step = 1e-4
        simulation_time = 1.0
        abs_tol = 1e-3
        rel_tol = 1e-3
        init_sim_step = 1e-6
        r_on_sw = 1e-3
        v_on_diode = 0.1
        data_sampling_rate = 0
        feedthrough_validation_error_level = error
    }

    component Subsystem Root {
        component "core/Three Phase Voltage Source" Vs1 {
        }
        [
            position = 8840, 8268
            hide_name = True
            scale = -1, 1
            size = 62, 256
        ]

        component "core/Inductor" L1 {
            inductance = "L"
        }
        [
            position = 8684, 8172
            hide_name = True
        ]

        component "core/Inductor" L2 {
            inductance = "L"
        }
        [
            position = 8684, 8268
            hide_name = True
        ]

        component "core/Inductor" L3 {
            inductance = "L"
        }
        [
            position = 8684, 8364
            hide_name = True
        ]

        component "core/Ground" gnd1 {
        }
        [
            position = 8920, 8332
            hide_name = True
        ]

        component "core/Resistor" R1 {
            resistance = "R"
        }
        [
            position = 8576, 8172
            hide_name = True
        ]

        component "core/Resistor" R2 {
            resistance = "R"
        }
        [
            position = 8576, 8268
            hide_name = True
        ]

        component "core/Resistor" R3 {
            resistance = "R"
        }
        [
            position = 8576, 8364
            hide_name = True
        ]

        component "core/Signal Controlled Voltage Source" Vsp1 {
        }
        [
            position = 8360, 8216
            rotation = right
            hide_name = True
            scale = -1, 1
            size = 64, 32
        ]

        component "core/Signal Controlled Voltage Source" Vsp2 {
        }
        [
            position = 8412, 8312
            rotation = right
            hide_name = True
            scale = -1, 1
            size = 64, 32
        ]

        component "core/Signal Controlled Voltage Source" Vsp3 {
        }
        [
            position = 8460, 8404
            rotation = right
            hide_name = True
            scale = -1, 1
            size = 64, 32
        ]

        component "core/Ground" gnd2 {
        }
        [
            position = 8412, 8476
            hide_name = True
        ]

        component "core/Sinusoidal Source" "Sinusoidal Source1" {
            amplitude = "V_rect"
            frequency = "F"
            phase = "phase"
        }
        [
            position = 7708, 8380
            hide_name = True
        ]

        component "core/Bus Split" "Bus Split1" {
            outputs = "3"
        }
        [
            position = 8264, 8312
            hide_name = True
        ]

        component "core/Probe" Probe1 {
        }
        [
            position = 7764, 8380
        ]

        junction Junction1 pe
        [
            position = 8412, 8444
        ]

        connect L1.n_node Vs1.a_node as Connection1
        connect L2.n_node Vs1.b_node as Connection2
        connect L3.n_node Vs1.c_node as Connection3
        connect Vs1.n_node gnd1.node as Connection4
        connect R3.n_node L3.p_node as Connection5
        connect L2.p_node R2.n_node as Connection6
        connect R1.n_node L1.p_node as Connection7
        connect Vsp1.p_node R1.p_node as Connection8
        connect Vsp2.p_node R2.p_node as Connection9
        connect Vsp3.p_node R3.p_node as Connection10
        connect Vsp2.n_node Junction1 as Connection12
        connect Junction1 gnd2.node as Connection13
        connect Vsp3.n_node Junction1 as Connection14
        connect Vsp1.n_node Junction1 as Connection15
        [
            breakpoints = 8360, 8444; 8412, 8444
        ]
        connect "Bus Split1.out" Vsp1.in as Connection17
        connect "Bus Split1.out1" Vsp2.in as Connection18
        connect "Bus Split1.out2" Vsp3.in as Connection19
        [
            breakpoints = 8328, 8328; 8328, 8404
        ]
        connect "Sinusoidal Source1.out" Probe1.in as Connection20
    }

    logically_deleted {
        "Vs1"
        "L1"
        "L2"
        "L3"
        "gnd1"
        "R1"
        "R2"
        "R3"
        "Vsp1"
        "Vsp2"
        "Vsp3"
        "gnd2"
        "Bus Split1"
        "Junction1"
        "Connection1"
        "Connection2"
        "Connection3"
        "Connection4"
        "Connection5"
        "Connection6"
        "Connection7"
        "Connection8"
        "Connection9"
        "Connection10"
        "Connection12"
        "Connection13"
        "Connection14"
        "Connection15"
        "Connection17"
        "Connection18"
        "Connection19"
    }

    default {
        "core/Bus Split" {
            outputs = "2"
            execution_rate = "inherit"
        }

        "core/Inductor" {
            signal_access = "inherit"
            inductance = "1e-3"
            initial_current = "0.0"
            pole_shift_ignore = "False"
            visible = "True"
        }

        "core/Probe" {
            signal_access = "inherit"
            addr = "0"
            override_signal_name = "False"
            signal_name = ""
            signal_type = "generic"
            streaming_en = "False"
            streaming_er_idx = "0"
            execution_rate = "inherit"
        }

        "core/Resistor" {
            resistance = "1"
            param_set = ""
        }

        "core/Sinusoidal Source" {
            amplitude = "1"
            dc_offset = "0"
            frequency = "50"
            phase = "0"
            execution_rate = "100e-6"
            _tunable = "False"
        }

        "core/Signal Controlled Voltage Source" {
            execution_rate = "inherit"
        }

        "core/Three Phase Voltage Source" {
            init_rms_value = "0.0"
            init_frequency = "50.0"
            init_phase = "0.0"
        }
    }

    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        # The Schematic API is imported as 'mdl'
        # To get the model file path, use 'mdl.get_model_file_path()'
        # To print information to the console, use info()
        
        import os
        
        # Get the directory where the .tse model file is located
        model_dir = os.path.dirname(mdl.get_model_file_path())
        
        # Create the full path to your parameter file
        param_file_path = os.path.join(model_dir, "simple_avg_rectifier.py")
        
        # Read and execute the entire file
        with open(param_file_path, 'r') as f:
            exec(f.read(), globals(), locals())
    ENDCODE
}
