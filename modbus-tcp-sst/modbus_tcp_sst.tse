        connect Constant3.out Junction10 as Connection40
        connect Junction10 "ModBus Device3.coil_in" as Connection41
        connect coil_out2.in "ModBus Device3.coil_out" as Connection42
        connect holding_out2.in Junction11 as Connection43
        connect Junction11 "ModBus Device3.holding_out" as Connection44
        connect "Bus Split3.in" Junction11 as Connection45
        connect REF_VDC_OUTPUT1.in "Bus Split3.out" as Connection46
        [
            breakpoints = 8580, 9016; 8580, 9060
        ]
        connect "Bus Split3.out1" DC_LINK_CONTACTOR1.in as Connection47
        connect "Bus Split3.out2" STATUS1.in as Connection48
        connect "ModBus Device3.discrete_in" Junction12 as Connection49
        connect Junction12 Junction10 as Connection50
        [
            breakpoints = 8032, 8980
        ]
        connect "ModBus Device3.holding_in" Junction12 as Connection51
        connect "ModBus Device3.reg_in" Junction13 as Connection52
        connect Junction13 reg2.Out1 as Connection53
        connect reg_in2.in Junction13 as Connection54
    }

