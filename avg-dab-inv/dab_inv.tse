        }

        "core/Mean Value" {
            number_of_points = "1000"
            execution_rate = "inherit"
        }

        "core/Min Max" {
            operation = "min"
            inputs = "2"
            execution_rate = "inherit"
        }

        "core/PID controller" {
            controller_type = "PID"
